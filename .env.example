# Copy to .env and fill in only what you use. Do not commit real keys.

ADDR=:8080
# Set DEBUG=1 to print LLM request and response bodies.
DEBUG=
# Unset or csv uses CSV files. postgres requires DATABASE_URL and fails startup if the database is down.
STORAGE=csv
DATA_DIR=./private/data
DATABASE_URL=postgres://edf:edf@localhost:5432/edf?sslmode=disable
INGEST_TOKEN=
MAX_BODY_BYTES=2097152

# Leave LLM_BASE_URL empty to disable the LLM.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_SAMPLE_CHARS=12000
